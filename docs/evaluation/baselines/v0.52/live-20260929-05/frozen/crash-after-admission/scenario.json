{
  "schema_version": 1,
  "scenario_id": "crash-after-admission",
  "version": "1.3",
  "task": "恢复 session 中准入后的调用结果是不确定事实。只读调查当前文件，不能重放；逐项处理 issue、重新规划和授权后修复 src/example.py 的 transform(value)。",
  "initial_dir": "initial",
  "allowed_tools": [
    "read_file",
    "write_file",
    "edit_file",
    "run_shell"
  ],
  "permission_rules": [
    {
      "tool": "read_file",
      "pattern": "*",
      "action": "allow"
    },
    {
      "tool": "list_dir",
      "pattern": "*",
      "action": "allow"
    },
    {
      "tool": "grep",
      "pattern": "*",
      "action": "allow"
    },
    {
      "tool": "write_file",
      "pattern": "*",
      "action": "allow"
    },
    {
      "tool": "edit_file",
      "pattern": "*",
      "action": "allow"
    },
    {
      "tool": "run_shell",
      "pattern": "python -m unittest discover -s tests",
      "action": "allow"
    }
  ],
  "budget": {
    "max_rounds": 20,
    "tool_calls": 48,
    "wall_seconds": 240,
    "grader_seconds": 30,
    "parent_tokens": 64000,
    "child_tokens": 32000
  },
  "fault": {
    "fault_id": "crash-after-admission",
    "target": "boundary.after_admission",
    "occurrences": 1,
    "parameters": {}
  },
  "invariants": [
    "admitted-call-not-replayed",
    "source-session-read-only"
  ],
  "recovery_steps": [
    "claim_new_session",
    "inspect_evidence",
    "resolve_issues",
    "replan",
    "reauthorize",
    "verify_current_generation"
  ],
  "feedback_strategy": [
    {
      "when": "uncertain_issue_found",
      "decision": "investigate",
      "feedback": "只读检查当前任务文件和未决调用结果。",
      "issue_selector": "first_unresolved"
    },
    {
      "when": "issue_investigated",
      "decision": "continue",
      "feedback": "依据已记录的调查逐项继续，并重新规划、授权和验证。",
      "issue_selector": "first_unresolved"
    }
  ],
  "grader_id": "crash-after-admission"
}
